  imap_manager.py --folder-type <TAB>   # Mostra tipi cartella disponibili
  imap_manager.py -f <TAB>              # Suggerisce cartelle comuni
  imap_manager.py -d <TAB>              # Suggerisce formati data
  imap_manager.py -a <TAB>              # Suggerisce header comuni
  
Opzioni supportate:
  -l, --list                    Elenca cartelle
  -f, --folder                  Specifica cartella
  -s, --server                  Server IMAP
  -u, --user                    Username
  -p, --password                Password
  -d, --datascope               Intervallo date
  -e, --expunge                 Cancella definitivamente
  -a, --and-header              Filtro AND su header
  -o, --or-header               Filtro OR su header
  --archive                     Archivia in cartella IMAP
  --archive-to-disk             Archivia su disco
  --copy-to-maildir            Copia in MAILDIR
  --move-to-maildir            Sposta in MAILDIR
  --folder-type                 Tipo cartella
  --filter-logic                Logica filtri
  --message-count-min           Minimo messaggi
  --message-count-max           Massimo messaggi
  --message-count-exact         Esatto messaggi
  --debug                       Modalità debug
  --no-save-csv                 Non salvare CSV
  --help                        Mostra aiuto

Per installare permanentemente:
  sudo cp imap_manager-completion.bash /etc/bash_completion.d/imap_manager.py
  
Per installare per utente corrente:
  mkdir -p ~/.local/share/bash-completion/completions
  cp imap_manager-completion.bash ~/.local/share/bash-completion/completions/imap_manager.py
EOF
}

# Registra la funzione di completamento
complete -F _imap_manager_completion imap_manager.py

# Registra anche per il caso in cui lo script sia chiamato senza estensione
complete -F _imap_manager_completion imap_manager

# Alias per la funzione di help
alias imap_manager_completion_help='_imap_manager_help'

# Messaggio di installazione (mostrato solo quando source manualmente)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "Bash completion per imap_manager.py caricato!"
    echo "Utilizza 'imap_manager_completion_help' per vedere la guida."
    echo ""
    echo "Per installazione permanente:"
    echo "  mkdir -p ~/.local/share/bash-completion/completions"
    echo "  cp ${BASH_SOURCE[0]} ~/.local/share/bash-completion/completions/imap_manager.py"
fi
